# Staging Environment Configuration
NODE_ENV=staging
PORT=3000
LOG_LEVEL=info

# Application Settings
APP_NAME=clair-telegram-bot-staging
SESSION_TIMEOUT=3600000

# Telegram Configuration (staging bot)
TELEGRAM_BOT_TOKEN=your_staging_bot_token_here
TELEGRAM_POLLING_INTERVAL=1000
TELEGRAM_RATE_LIMIT_PER_USER=15

# AI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=800
OPENAI_TEMPERATURE=0.1

# Clair API (staging environment)
CLAIR_API_URL=https://api-staging.clair.finance
CLAIR_API_KEY=your_staging_clair_api_key_here
CLAIR_API_TIMEOUT=20000

# Supabase (staging project)
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your_staging_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_staging_supabase_service_role_key_here

# Redis (staging instance)
REDIS_URL=redis://staging-redis:6379
REDIS_PASSWORD=your_staging_redis_password_here
REDIS_DB=0

# Monitoring
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=staging
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_SERVICE_NAME=clair-telegram-bot-staging

HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# Feature Flags (production-like but with some experimental features)
FEATURE_SUBSCRIPTIONS_ENABLED=true
FEATURE_INSIGHTS_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_MULTILINGUAL_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true

# Development Settings (disabled in staging)
DEV_MOCK_EXTERNAL_APIS=false
DEV_LOG_REQUESTS=false
DEV_ENABLE_DEBUG_ENDPOINTS=false

# Rate Limiting (production-like)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=https://staging.clair.finance
SECURITY_HEADERS_ENABLED=true