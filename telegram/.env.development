# Development Environment Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Application Settings
APP_NAME=clair-telegram-bot-dev
SESSION_TIMEOUT=1800000

# Telegram Configuration (use test bot for development)
TELEGRAM_BOT_TOKEN=your_dev_bot_token_here
TELEGRAM_POLLING_INTERVAL=2000
TELEGRAM_RATE_LIMIT_PER_USER=20

# AI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.1

# Clair API (use staging/dev environment)
CLAIR_API_URL=https://api-dev.clair.finance
CLAIR_API_KEY=your_dev_clair_api_key_here
CLAIR_API_TIMEOUT=30000

# Supabase (use development project)
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=your_dev_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_dev_supabase_service_role_key_here

# Redis (local development)
REDIS_URL=redis://localhost:6379
REDIS_DB=1

# Monitoring (optional in development)
SENTRY_ENVIRONMENT=development
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60000

# Feature Flags (enable all for testing)
FEATURE_SUBSCRIPTIONS_ENABLED=true
FEATURE_INSIGHTS_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_MULTILINGUAL_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true

# Development Settings
DEV_MOCK_EXTERNAL_APIS=false
DEV_LOG_REQUESTS=true
DEV_ENABLE_DEBUG_ENDPOINTS=true

# Rate Limiting (more lenient for development)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200