# Production Environment Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=warn

# Application Settings
APP_NAME=clair-telegram-bot
SESSION_TIMEOUT=3600000

# Telegram Configuration (production bot)
TELEGRAM_BOT_TOKEN=your_production_bot_token_here
TELEGRAM_WEBHOOK_URL=https://bot.clair.finance/webhook
TELEGRAM_WEBHOOK_SECRET=your_production_webhook_secret_here
TELEGRAM_POLLING_INTERVAL=1000
TELEGRAM_RATE_LIMIT_PER_USER=10

# AI Configuration
OPENAI_API_KEY=your_production_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.1
AI_TIMEOUT=30000
AI_MAX_RETRIES=3

# Clair API (production)
CLAIR_API_URL=https://api.clair.finance
CLAIR_API_KEY=your_production_clair_api_key_here
CLAIR_API_TIMEOUT=15000

# Supabase (production project)
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=your_production_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_production_supabase_service_role_key_here

# Redis (production cluster)
REDIS_URL=redis://production-redis-cluster:6379
REDIS_PASSWORD=your_production_redis_password_here
REDIS_DB=0
REDIS_TIMEOUT=5000

# Monitoring (full monitoring in production)
SENTRY_DSN=your_production_sentry_dsn_here
SENTRY_ENVIRONMENT=production
DATADOG_API_KEY=your_production_datadog_api_key_here
DATADOG_SERVICE_NAME=clair-telegram-bot

HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# Feature Flags (stable features only)
FEATURE_SUBSCRIPTIONS_ENABLED=true
FEATURE_INSIGHTS_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_MULTILINGUAL_ENABLED=true
FEATURE_ANALYTICS_ENABLED=false

# Development Settings (all disabled in production)
DEV_MOCK_EXTERNAL_APIS=false
DEV_LOG_REQUESTS=false
DEV_ENABLE_DEBUG_ENDPOINTS=false

# Rate Limiting (strict in production)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50

# Security (strict settings)
CORS_ORIGIN=https://clair.finance
CORS_CREDENTIALS=false
SECURITY_HEADERS_ENABLED=true

# Deployment
DOCKER_IMAGE_TAG=production
SHUTDOWN_TIMEOUT=10000