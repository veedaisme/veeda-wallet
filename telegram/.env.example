# Clair Telegram Bot Environment Configuration
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in the appropriate values for each environment

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# Node.js Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Application Settings
APP_NAME=clair-telegram-bot
APP_VERSION=1.0.0
SESSION_TIMEOUT=3600000

# =============================================================================
# TELEGRAM CONFIGURATION
# =============================================================================

# Telegram Bot Token (required)
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Webhook Configuration (optional, for webhook mode)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Telegram Bot Settings
TELEGRAM_POLLING_INTERVAL=1000
TELEGRAM_RATE_LIMIT_PER_USER=10

# =============================================================================
# AI CONFIGURATION
# =============================================================================

# OpenAI API Configuration (required)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.1

# AI Service Settings
AI_TIMEOUT=30000
AI_MAX_RETRIES=3

# =============================================================================
# CLAIR API CONFIGURATION
# =============================================================================

# Clair API Base URL and Authentication
CLAIR_API_URL=https://api.clair.finance
CLAIR_API_KEY=your_clair_api_key_here
CLAIR_API_TIMEOUT=15000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# MCP Server Configuration
MCP_SERVER_ENABLED=true
MCP_SERVER_TIMEOUT=20000

# =============================================================================
# REDIS CONFIGURATION (optional, for caching and rate limiting)
# =============================================================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_TIMEOUT=5000

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================

# Sentry Error Tracking (optional)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# DataDog Monitoring (optional)
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_SERVICE_NAME=clair-telegram-bot

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature toggles
FEATURE_SUBSCRIPTIONS_ENABLED=true
FEATURE_INSIGHTS_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_MULTILINGUAL_ENABLED=true
FEATURE_ANALYTICS_ENABLED=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Security Headers
SECURITY_HEADERS_ENABLED=true

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development-specific settings
DEV_MOCK_EXTERNAL_APIS=false
DEV_LOG_REQUESTS=true
DEV_ENABLE_DEBUG_ENDPOINTS=true

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Docker Configuration
DOCKER_IMAGE_TAG=latest
DOCKER_REGISTRY=your-registry.com

# Health Check URLs
HEALTH_CHECK_URL=/health
READINESS_CHECK_URL=/ready

# Graceful Shutdown
SHUTDOWN_TIMEOUT=10000